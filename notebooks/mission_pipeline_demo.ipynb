## 2. Test Kafka Connection
```python
from kafka import KafkaProducer, KafkaConsumer
import json

producer = KafkaProducer(
    bootstrap_servers="kafka:9092",
    value_serializer=lambda v: json.dumps(v).encode()
)
producer.send("tracking_events", {"test": "hello from notebook", "label": "person"})
print("✅ Kafka producer OK")
```

## 3. Test VSS Agent
```python
import httpx, asyncio

async def test_vss():
    async with httpx.AsyncClient(timeout=30.0) as client:
        r = await client.post("http://vss-agent:8000/query", json={
            "question": "Any suspicious activity in the last 10 minutes?"
        })
        print(r.json())

asyncio.run(test_vss())
```

## 4. Test Cosmos Predictor
```python
async def test_cosmos():
    async with httpx.AsyncClient(timeout=30.0) as client:
        r = await client.post("http://cosmos-predictor:8001/predict", json={
            "global_id": 42,
            "trajectory": [
                {"timestamp": "2026-03-11T10:00:00", "x": 100, "y": 200,
                 "label": "person", "camera_id": 0, "confidence": 0.92},
                {"timestamp": "2026-03-11T10:00:01", "x": 115, "y": 205,
                 "label": "person", "camera_id": 0, "confidence": 0.91},
            ],
            "horizon_seconds": 30,
            "mission_context": "perimeter_security",
            "restricted_zones": [{"name": "zone_a", "x": 200, "y": 200, "radius": 50}]
        })
        print(r.json())

asyncio.run(test_cosmos())
```

