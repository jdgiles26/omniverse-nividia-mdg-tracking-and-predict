# ─── DASHBOARD SERVER ────────────────────────────────────────────
FROM --platform=linux/amd64 python:3.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Install dashboard runtime dependencies explicitly.
# This avoids partial installs from the root requirements file (which includes
# optional packages like pyaudio that can fail on slim images).
RUN pip install --no-cache-dir \
    fastapi==0.110.0 \
    "uvicorn[standard]==0.29.0" \
    redis==5.0.4 \
    httpx==0.27.0 \
    jinja2==3.1.3

# Copy application
COPY dashboard/ ./

# Expose port
EXPOSE 8080

# Start the dashboard server
CMD ["python3", "app.py"]
