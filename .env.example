# NVIDIA API Key (for NIM microservices — get at build.nvidia.com)
NVIDIA_API_KEY=nvapi-your-key-here

# Video Sources (comma-separated: webcam, rtsp://..., http://..., /uploads/file.mp4)
VIDEO_SOURCES=webcam,rtsp://192.168.1.100:554/stream1

# Postgres
POSTGRES_PASSWORD=mission_secret

# Mission Rules
THREAT_THRESHOLD=0.75
PREDICTION_HORIZON_SEC=30
CORRELATION_WINDOW_SEC=60

# Kafka Topics
KAFKA_TOPIC_DETECTIONS=raw_detections
KAFKA_TOPIC_TRACKING=tracking_events
KAFKA_TOPIC_FUSED=fused_events
KAFKA_TOPIC_ALERTS=mission_alerts
KAFKA_TOPIC_PREDICTIONS=cosmos_predictions
KAFKA_TOPIC_SUMMARIES=vss_summaries

# Alert Webhooks (optional)
WEBHOOK_URL=https://your-webhook.example.com/alerts